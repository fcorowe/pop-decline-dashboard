{
  "name": "pop-decline-dashboard",
  "version": "1.0.0",
  "description": "Interactive dashboard of European sub-national population decline, 2000-2018",
  "scripts": {
    "build:data": "python3 scripts/build_data.py",
    "serve": "python3 -m http.server 8000 -d site",
    "test": "python3 -m pytest tests -q && playwright test",
    "test:ui": "playwright test",
    "data": "python3 scripts/build_data.py",
    "snapshots": "playwright test tests/visual.spec.js --project=desktop --project=iphone --update-snapshots",
    "build:vendor": "node scripts/build_vendor.mjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@playwright/test": "1.65.1",
    "d3-array": "3.2.5",
    "d3-color": "3.1.1",
    "d3-format": "3.1.3",
    "d3-geo": "3.1.2",
    "d3-interpolate": "3.0.2",
    "d3-scale": "4.0.3",
    "d3-selection": "3.0.1",
    "d3-shape": "3.2.1",
    "d3-transition": "3.0.2",
    "d3-zoom": "3.0.1",
    "esbuild": "0.28.2",
    "mapshaper": "0.6.121",
    "topojson-client": "3.1.0"
  },
  "private": true
}
